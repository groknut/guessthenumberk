<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".GuesserActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/YourNumberIs"
        android:textAlignment="center"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/GuessedNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:textSize="64sp"
        android:textAlignment="center"
        android:text="0" />

    <LinearLayout
        android:id="@+id/ButtonsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="50dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/yesBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/yes" />

        <Button
            android:id="@+id/GreaterBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/noGreater" />

        <Button
            android:id="@+id/LesserBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/noLesser" />
    </LinearLayout>

    <Button
        android:id="@+id/restart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="50dp"
        android:layout_marginTop="16dp"
        android:text="@string/button_restart"
        android:visibility="gone" />

</LinearLayout>